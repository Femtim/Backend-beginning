<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Records</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <style>
      body {
        min-height: 100vh;
        background: #f3f6f4;
        color: #18332c;
      }

      .records-shell {
        max-width: 1180px;
      }

      .records-table {
        min-width: 760px;
      }

      .records-table thead th {
        padding: 1rem 1.25rem;
        background: #173c32;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .records-table tbody td {
        padding: 1rem 1.25rem;
        color: #344b44;
      }

      .records-table tbody tr:last-child td {
        border-bottom: 0;
      }
    </style>
  </head>
  <body>
    <main class="container records-shell py-5">
      <header class="d-flex flex-column flex-sm-row align-items-sm-end justify-content-between gap-3 mb-4">
        <div>
          <p class="text-uppercase fw-semibold small mb-2" style="color: #39836c; letter-spacing: 0.12em;">Directory</p>
          <h1 class="h2 fw-bold mb-1">User records</h1>
          <p class="text-secondary mb-0">A complete list of registered users</p>
        </div>
        <span class="badge rounded-pill px-3 py-2" style="background: #dcece5; color: #205c49;">
          <%= allUser.length %> <%= allUser.length === 1 ? "record" : "records" %>
        </span>
      </header>

      <section class="bg-white border rounded-3 shadow-sm overflow-hidden" aria-label="User records table">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 records-table">
            <thead>
              <tr>
                  <th scope="col">#</th>
                <th scope="col">First name</th>
                <th scope="col">Last name</th>
                <th scope="col">Email</th>
                <th scope="col">Age</th>
                <th scope="col">Gender</th>
                <th scope="col">Phone</th>
                <th scope="col">verificationStatus</th>
                <th scope="col"></th>
                <th scope="col"></th>
                
              </tr>
            </thead>
            <tbody>
              <% if (allUser.length === 0) { %>
                <tr>
                  <td colspan="7" class="text-center text-secondary py-5">No user records to display.</td>
                </tr>
              <% } else { allUser.map((user, index) => { %>
                <tr>
                  <td class="text-secondary fw-semibold"><%= index + 1 %></td>
                  <td><%= user.firstName %></td>
                  <td><%= user.lastName %></td>
                  <td><%= user.email %></td>
                  <td><%= user.age %></td>
                  <td><%= user.gender %></td>
                  <td><%= user.phone %></td>
                  <td><%= user.verificationStatus %></td>
                   <td><form action="/edit" method="post">
                <button type="submit">Edit</button>
              </form></td>
                  <td><form action="/delete/<%= user._id %>" method="post">
                <button type="submit">Delete</button>
              </form></td>
                </tr>
              <% }); } %>
              
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </body>
</html>
