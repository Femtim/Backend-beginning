<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create account</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: light;
        --ink: #24332f;
        --muted: #71807b;
        --accent: #237a63;
        --canvas: #f3f7f4;
      }

      body {
        min-height: 100vh;
        background: var(--canvas);
        color: var(--ink);
        font-family: "Segoe UI", sans-serif;
      }

      .signup-card {
        max-width: 620px;
        border: 1px solid #e4ebe6;
        border-radius: 12px;
        box-shadow: 0 18px 50px rgba(36, 51, 47, 0.08);
      }

      .form-label {
        margin-bottom: 0.4rem;
        font-size: 0.9rem;
        font-weight: 600;
      }

      .form-control,
      .form-select {
        min-height: 46px;
        border-color: #d9e2dc;
        border-radius: 7px;
      }

      .form-control:focus,
      .form-select:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 0.2rem rgba(35, 122, 99, 0.14);
      }

      .btn-create {
        min-height: 48px;
        border: 0;
        border-radius: 7px;
        background: var(--accent);
        font-weight: 600;
      }

      .btn-create:hover {
        background: #1c644f;
      }
    </style>
  </head>

  <body>
    <main class="container min-vh-100 d-flex align-items-center justify-content-center py-4">
      <section class="signup-card card w-100">
        <div class="card-body p-4 p-md-5">
          <header class="mb-4">
            <p class="small text-uppercase fw-semibold mb-2" style="color: var(--accent);">Get started</p>
            <h1 class="h3 fw-bold mb-2">Create your account</h1>
            <p class="mb-0" style="color: var(--muted);">Enter your details to get started.</p>
          </header>

          <form action="/dashboard" method="POST">
            <div class="row g-3">
              <div class="col-sm-6">
                <label for="firstName" class="form-label">First name</label>
                <input class="form-control" type="text" id="firstName" name="firstName" placeholder="e.g. Jordan" autocomplete="given-name" required />
              </div>
              <div class="col-sm-6">
                <label for="lastName" class="form-label">Last name</label>
                <input class="form-control" type="text" id="lastName" name="lastName" placeholder="e.g. Lee" autocomplete="family-name" required />
              </div>
              <div class="col-sm-7">
                <label for="email" class="form-label">Email address</label>
                <input class="form-control" type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required />
              </div>
              <div class="col-sm-5">
                <label for="phone" class="form-label">Phone number</label>
                <input class="form-control" type="tel" id="phone" name="phone" placeholder="Your phone number" autocomplete="tel" required />
              </div>
              <div class="col-sm-6">
                <label for="age" class="form-label">Age</label>
                <input class="form-control" type="number" id="age" name="age" min="1" placeholder="Your age" required />
              </div>
              <div class="col-sm-6">
                <label for="gender" class="form-label">Gender</label>
                <select class="form-select" id="gender" name="gender" required>
                  <option value="" selected disabled>Select an option</option>
                  <option value="female">Female</option>
                  <option value="male">Male</option>
                  <option value="others">Others</option>
                </select>
              </div>
              <div class="col-12">
                <label for="password" class="form-label">Password</label>
                <input class="form-control" type="password" id="password" name="password" autocomplete="new-password" required />
              </div>
              <div class="col-12 pt-2">
                <button type="submit" class="btn btn-create btn-success text-white w-100">Create account</button>
              </div>
            </div>
          </form>

          <form action="/dbuser" method="POST">
            <input type="text" name="searchInput">
            <button type="submit">Search</button>
          </form>
        </div>
      </section>
    </main>
  </body>
</html>
