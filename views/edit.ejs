<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: light;
        --ink: #24332f;
        --muted: #71807b;
        --accent: #237a63;
        --canvas: #f3f7f4;
      }

      body {
        min-height: 100vh;
        background: var(--canvas);
        color: var(--ink);
        font-family: "Segoe UI", sans-serif;
      }

      .signup-card {
        max-width: 620px;
        border: 1px solid #e4ebe6;
        border-radius: 12px;
        box-shadow: 0 18px 50px rgba(36, 51, 47, 0.08);
      }

      .form-label {
        margin-bottom: 0.4rem;
        font-size: 0.9rem;
        font-weight: 600;
      }

      .form-control,
      .form-select {
        min-height: 46px;
        border-color: #d9e2dc;
        border-radius: 7px;
      }

      .form-control:focus,
      .form-select:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 0.2rem rgba(35, 122, 99, 0.14);
      }

      .btn-create {
        min-height: 48px;
        border: 0;
        border-radius: 7px;
        background: var(--accent);
        font-weight: 600;
      }

      .btn-create:hover {
        background: #1c644f;
      }
    </style>
  </head>
  <body
    class="container min-vh-100 d-flex align-items-center justify-content-center py-4"
  >
    <form action="/edit" method="POST">
      <div class="row g-3">
        <h1>Edit Record</h1>
        <div class="col-sm-6">
          <label for="firstName" class="form-label">First name</label>
          <input
            class="form-control"
            type="text"
            id="firstName"
            value="<%= prevRecord.firstName %>"
          />
        </div>
        <div class="col-sm-6">
          <label for="lastName" class="form-label">Last name</label>
          <input
            class="form-control"
            type="text"
            id="lastName"
            name="lastName"
            value="<%= prevRecord.lastName %>"
          />
        </div>
        <div class="col-sm-7">
          <label for="email" class="form-label">Email address</label>
          <input
            class="form-control"
            type="email"
            id="email"
            name="email"
            value="<%= prevRecord.email %>"
          />
        </div>
        <div class="col-sm-5">
          <label for="phone" class="form-label">Phone number</label>
          <input
            class="form-control"
            type="tel"
            id="phone"
            name="phone"
            value="<%= prevRecord.phone %>"
          />
        </div>
        <div class="col-sm-6">
          <label for="age" class="form-label">Age</label>
          <input
            class="form-control"
            type="number"
            id="age"
            name="age"
            value="<%= prevRecord.age %>"
          />
        </div>

        <div class="col-sm-6">
          <label for="age" class="form-label">Age</label>
          <input
            class="form-control"
            type="text"
            id="gender"
            name="gender"
            value="<%= prevRecord.gender %>"
          />
        </div>
        <div class="col-12 pt-2">
          <button
            type="submit"
            class="btn btn-create btn-success text-white w-50"
          >
            Submit
          </button>
        </div>
      </div>
    </form>
  </body>
</html>
